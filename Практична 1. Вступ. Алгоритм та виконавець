Example 1:

Input: low = 3, high = 7
Output: 3
Example 2:

Input: low = 8, high = 10
Output: 1

class Solution {
public:
    int countOdds(int low, int high) {
        int count = 0;

        for (int i = low; i <= high; i++) {
            if (i % 2 != 0) {
                count++;
            }
        }

        return count;
    }
};
